<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="520"
		x:Class="PSMultiTools.PSV.Tools.PSVIMGTools"
		Title="PSV IMG Tools" Height="520" Width="760" CanResize="False" CanMinimize="True" WindowStartupLocation="CenterScreen" RequestedThemeVariant="Dark">
	<Grid>
		<!-- Backup Key Header -->
		<TextBlock HorizontalAlignment="Left" Margin="10,10,0,0" Text="CMA / AID Backup Key (Hex):" VerticalAlignment="Top" FontSize="14"/>
		<TextBox x:Name="BackupKeyTextBox" HorizontalAlignment="Left" Margin="10,34,0,0" VerticalAlignment="Top" Width="330"/>

		<!-- Section 1: Extract PSVIMG -->
		<TextBlock HorizontalAlignment="Left" Margin="10,72,0,0" Text="Extract PSVIMG" VerticalAlignment="Top" FontSize="16" FontWeight="Bold"/>
		<TextBlock HorizontalAlignment="Left" Margin="10,98,0,0" Text="Select a .psvimg file:" VerticalAlignment="Top" FontSize="13"/>
		<TextBox x:Name="SelectedPSVIMGFileTextBox" HorizontalAlignment="Left" Margin="10,120,0,0" VerticalAlignment="Top" Width="250"/>
		<Button x:Name="BrowsePSVIMGButton" Content="Browse" HorizontalAlignment="Left" Margin="265,119,0,0" VerticalAlignment="Top" Width="75"/>
		<TextBlock HorizontalAlignment="Left" Margin="10,152,0,0" Text="Select an output folder:" VerticalAlignment="Top" FontSize="13"/>
		<TextBox x:Name="ExtractOutputFolderTextBox" HorizontalAlignment="Left" Margin="10,174,0,0" VerticalAlignment="Top" Width="250"/>
		<Button x:Name="BrowseExtractOutputFolderButton" Content="Browse" HorizontalAlignment="Left" Margin="265,173,0,0" VerticalAlignment="Top" Width="75"/>
		<Button x:Name="ExtractPSVIMGButton" Content="Extract PSVIMG" HorizontalAlignment="Left" Margin="10,210,0,0" VerticalAlignment="Top" Width="330" FontWeight="Bold"/>

		<!-- Section 2: Decrypt PSVMD -->
		<TextBlock HorizontalAlignment="Left" Margin="10,250,0,0" Text="Decrypt PSVMD" VerticalAlignment="Top" FontSize="16" FontWeight="Bold"/>
		<TextBlock HorizontalAlignment="Left" Margin="10,276,0,0" Text="Select a .psvmd file:" VerticalAlignment="Top" FontSize="13"/>
		<TextBox x:Name="SelectedPSVMDDecryptFileTextBox" HorizontalAlignment="Left" Margin="10,298,0,0" VerticalAlignment="Top" Width="250"/>
		<Button x:Name="BrowsePSVMDButton" Content="Browse" HorizontalAlignment="Left" Margin="265,297,0,0" VerticalAlignment="Top" Width="75"/>
		<TextBlock HorizontalAlignment="Left" Margin="10,330,0,0" Text="Select an output folder:" VerticalAlignment="Top" FontSize="13"/>
		<TextBox x:Name="DecryptOutputFolderTextBox" HorizontalAlignment="Left" Margin="10,352,0,0" VerticalAlignment="Top" Width="250"/>
		<Button x:Name="BrowseDecryptOutputFolderButton" Content="Browse" HorizontalAlignment="Left" Margin="265,351,0,0" VerticalAlignment="Top" Width="75"/>
		<Button x:Name="DecryptPSVMDButton" Content="Decrypt PSVMD" HorizontalAlignment="Left" Margin="10,388,0,0" VerticalAlignment="Top" Width="330" FontWeight="Bold"/>

		<!-- Section 3: Create PSVIMG -->
		<TextBlock HorizontalAlignment="Left" Margin="380,72,0,0" Text="Create PSVIMG" VerticalAlignment="Top" FontSize="16" FontWeight="Bold"/>
		<TextBlock HorizontalAlignment="Left" Margin="380,98,0,0" Text="Select decrypted metadata (.psvmd, optional):" VerticalAlignment="Top" FontSize="13"/>
		<TextBox x:Name="SelectedMetadataFileTextBox" HorizontalAlignment="Left" Margin="380,120,0,0" VerticalAlignment="Top" Width="270"/>
		<Button x:Name="BrowseMetadataFileButton" Content="Browse" HorizontalAlignment="Left" Margin="655,119,0,0" VerticalAlignment="Top" Width="75"/>

		<TextBlock HorizontalAlignment="Left" Margin="380,152,0,0" Text="Specify name / title (if no metadata):" VerticalAlignment="Top" FontSize="13"/>
		<TextBox x:Name="SelectedNameTextBox" HorizontalAlignment="Left" Margin="380,174,0,0" VerticalAlignment="Top" Width="350"/>

		<TextBlock HorizontalAlignment="Left" Margin="380,206,0,0" Text="Select input folder (files to pack):" VerticalAlignment="Top" FontSize="13"/>
		<TextBox x:Name="CreateInputFolderTextBox" HorizontalAlignment="Left" Margin="380,228,0,0" VerticalAlignment="Top" Width="270"/>
		<Button x:Name="BrowseCreateInputFolderButton" Content="Browse" HorizontalAlignment="Left" Margin="655,227,0,0" VerticalAlignment="Top" Width="75"/>

		<TextBlock HorizontalAlignment="Left" Margin="380,260,0,0" Text="Select output folder:" VerticalAlignment="Top" FontSize="13"/>
		<TextBox x:Name="CreateOutputFolderTextBox" HorizontalAlignment="Left" Margin="380,282,0,0" VerticalAlignment="Top" Width="270"/>
		<Button x:Name="BrowseCreateOutputFolderButton" Content="Browse" HorizontalAlignment="Left" Margin="655,281,0,0" VerticalAlignment="Top" Width="75"/>

		<Button x:Name="CreatePSVIMGButton" Content="Create PSVIMG" HorizontalAlignment="Left" Margin="380,322,0,0" VerticalAlignment="Top" Width="350" FontWeight="Bold"/>

		<!-- Status / Log at bottom -->
		<TextBlock HorizontalAlignment="Left" Margin="10,432,0,0" Text="Status / Log:" VerticalAlignment="Top" FontSize="13"/>
		<TextBox x:Name="LogTextBox" HorizontalAlignment="Left" Margin="10,454,0,0" VerticalAlignment="Top" Width="720" Height="50" IsReadOnly="True"/>
	</Grid>
</Window>
